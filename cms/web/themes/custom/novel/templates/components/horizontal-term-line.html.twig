{{ attach_library('novel/horizontal-term-line') }}
{% set heading = heading|default('h2') %}

<div class="horizontal-term-line">
  <{{ heading }} class="text-label-bold">
    {{ title }}
  </{{ heading }}>

  {% for item in items %}
    <span>
      {{ item.content|add_class('link-tag') }}
    </span>
  {% endfor %}
</div>
