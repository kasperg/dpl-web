{{ attach_library('novel/disclosure') }}
<details {{ attributes.addClass('disclosure', 'disclosure--paragraph-width') }}>
<summary class="disclosure__headline">
    <h2 class="disclosure__text">
      {{ content.field_accordion_title }}
    </h2>
      <img class="disclosure__expand" src="{{ absoluteBaseUrl ~ '/' ~ baseIconPath ~ '/collection/ExpandMore.svg' }}" alt="Icon Description" />
  </summary>
  <div class="disclosure__content-padding rich-text">
    {{ content.field_accordion_description }}
  </div>
</details>
